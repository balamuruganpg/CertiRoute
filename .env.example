# Copy to .env from the repository root; configure model endpoints in gateway.yaml.
# Calls to /v1/chat/completions now contact the configured provider.
CERTIROUTE_CONFIG_FILE=configs/gateway.yaml
# Required for authenticated routes. Choose a secret; there is no built-in default.
# Blank or unset rejects /v1/models and /v1/chat/completions, including bearer
# certiroute-local.
CERTIROUTE_API_KEY=
# Trusted local process only. If CERTIROUTE_API_KEY is unset, set this to 1 to
# accept the published bearer certiroute-local. The gateway logs a warning.
# Do not enable it on a shared or exposed host.
# CERTIROUTE_ALLOW_INSECURE_LOCAL_KEY=1
# Reserved for the future admin endpoint; use a separate secret.
CERTIROUTE_ADMIN_API_KEY=
# Live study: CHEAP_API_KEY is Groq; XAI_API_KEY is xAI (Grok).
# Keep actual keys local. Gateway endpoints are configured separately in gateway.yaml.
CHEAP_API_KEY=
XAI_API_KEY=
