# Copy to .env from the repository root; configure model endpoints in gateway.yaml.
# Calls to /v1/chat/completions now contact the configured provider.
CERTIROUTE_CONFIG_FILE=configs/gateway.yaml
# Local development key only; replace before exposing the server.
CERTIROUTE_API_KEY=certiroute-local
# Reserved for the future admin endpoint; use a separate secret.
CERTIROUTE_ADMIN_API_KEY=
# Live study: CHEAP_API_KEY is Groq; XAI_API_KEY is xAI (Grok).
# Keep actual keys local. Gateway endpoints are configured separately in gateway.yaml.
CHEAP_API_KEY=
XAI_API_KEY=
